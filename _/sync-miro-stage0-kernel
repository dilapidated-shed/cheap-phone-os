#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
checkout=${MIRO_STAGE0_KERNEL_DIR:-"$root/_/miro-stage0-kernel"}
remote=${MIRO_STAGE0_KERNEL_REMOTE:-https://github.com/MotorolaMobilityLLC/kernel-sprd.git}
commit=${MIRO_STAGE0_KERNEL_COMMIT:-c4e610cd833c47f08969678fa58f9bfcb57bd3a5}

if [ -t 1 ]; then
    bold=$(printf '\033[1m')
    green=$(printf '\033[32m')
    reset=$(printf '\033[0m')
else
    bold=
    green=
    reset=
fi

printf '%s%sMIRO stage-0 kernel donor%s\n' "$bold" "$green" "$reset"
printf 'source:   %s\n' "$remote"
printf 'commit:   %s\n' "$commit"
printf 'checkout: %s\n' "$checkout"

if [ ! -d "$checkout/.git" ]; then
    mkdir -p "$(dirname -- "$checkout")"
    git clone --filter=blob:none --no-checkout "$remote" "$checkout"
fi

cd "$checkout"

current_remote=$(git remote get-url origin)
if [ "$current_remote" != "$remote" ]; then
    git remote set-url origin "$remote"
fi

git fetch --force origin "$commit"
git checkout --detach "$commit"

actual=$(git rev-parse HEAD)
if [ "$actual" != "$commit" ]; then
    printf 'expected %s but checked out %s\n' "$commit" "$actual" >&2
    exit 1
fi

printf '%s%sready%s %s\n' "$bold" "$green" "$reset" "$actual"
