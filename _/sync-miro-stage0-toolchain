#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
checkout=${MIRO_STAGE0_TOOLCHAIN_DIR:-"$root/_/toolchains/arm-linux-androideabi-4.9"}
remote=${MIRO_STAGE0_TOOLCHAIN_REMOTE:-https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9}
commit=${MIRO_STAGE0_TOOLCHAIN_COMMIT:-07d3ce5e50440d0652b94a78153c3d6e3f65976a}

if [ -t 1 ]; then
    bold=$(printf '\033[1m')
    green=$(printf '\033[32m')
    reset=$(printf '\033[0m')
else
    bold=
    green=
    reset=
fi

printf '%s%sMIRO stage-0 kernel toolchain%s\n' "$bold" "$green" "$reset"
printf 'source:   %s\n' "$remote"
printf 'commit:   %s\n' "$commit"
printf 'checkout: %s\n' "$checkout"

if [ ! -d "$checkout/.git" ]; then
    mkdir -p "$(dirname -- "$checkout")"
    git clone --filter=blob:none --no-checkout "$remote" "$checkout"
fi

cd "$checkout"

current_remote=$(git remote get-url origin)
if [ "$current_remote" != "$remote" ]; then
    git remote set-url origin "$remote"
fi

git fetch --force origin "$commit"
git checkout --detach "$commit"

actual=$(git rev-parse HEAD)
if [ "$actual" != "$commit" ]; then
    printf 'expected %s but checked out %s\n' "$commit" "$actual" >&2
    exit 1
fi

compiler="$checkout/bin/arm-linux-androideabi-gcc"
if [ ! -x "$compiler" ]; then
    printf 'expected compiler missing: %s\n' "$compiler" >&2
    exit 1
fi

printf '%s%sready%s %s\n' "$bold" "$green" "$reset" "$actual"
"$compiler" --version | sed -n '1p'
