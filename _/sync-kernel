#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
checkout=${CHEAP_PHONE_OS_KERNEL_DIR:-"$root/_/linux"}
remote=${KERNEL_REMOTE:-https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git}
ref=${KERNEL_REF:-v5.15.149}

if [ -t 1 ]; then
    bold=$(printf '\033[1m')
    green=$(printf '\033[32m')
    reset=$(printf '\033[0m')
else
    bold=
    green=
    reset=
fi

printf '%s%sKernel donor%s %s\n' "$bold" "$green" "$reset" "$ref"
printf 'source:   %s\n' "$remote"
printf 'checkout: %s\n' "$checkout"

if [ ! -d "$checkout/.git" ]; then
    mkdir -p "$(dirname -- "$checkout")"
    git clone --filter=blob:none --no-checkout "$remote" "$checkout"
fi

cd "$checkout"

current_remote=$(git remote get-url origin)
if [ "$current_remote" != "$remote" ]; then
    git remote set-url origin "$remote"
fi

git fetch --force origin "refs/tags/$ref:refs/tags/$ref"
git checkout --detach "$ref"

printf '%s%sready%s %s\n' "$bold" "$green" "$reset" "$(git rev-parse HEAD)"
