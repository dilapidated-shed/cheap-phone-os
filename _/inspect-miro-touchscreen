#!/bin/sh
set -eu

# Run directly on the MIRO by default.
#
# Optional remote mode, for inspecting another Android device:
#     sh _/inspect-miro-touchscreen --adb
#
# In remote mode we feed this same script to the target's shell without
# --adb, so the actual probe still reads the target's /sys and device tree
# locally.
if [ "${1:-}" = "--adb" ]; then
    adb_bin=${ADB:-adb}
    "$adb_bin" shell sh -s < "$0"
    exit
fi

if [ -d /sys/firmware/devicetree/base ]; then
    root=/sys/firmware/devicetree/base
elif [ -d /proc/device-tree ]; then
    root=/proc/device-tree
else
    echo "No live device tree found at /sys/firmware/devicetree/base or /proc/device-tree."
    exit 1
fi

text_property()
{
    file=$1
    label=$2
    if [ -r "$file" ]; then
        printf "%s: " "$label"
        tr "\000" "\n" < "$file"
    fi
}

hex_property()
{
    file=$1
    label=$2
    if [ -r "$file" ]; then
        printf "%s:" "$label"
        od -An -tx1 "$file" | tr -s " "
    fi
}

echo "== Platform =="
getprop ro.board.platform 2>/dev/null || true
getprop ro.hardware 2>/dev/null || true
getprop ro.boot.hardware 2>/dev/null || true

echo
echo "== I2C devices =="
found_i2c=false
for d in /sys/bus/i2c/devices/*
do
    [ -e "$d" ] || continue
    [ -r "$d/name" ] || continue
    found_i2c=true
    printf "%s  " "$(basename "$d")"
    cat "$d/name"
done
if [ "$found_i2c" = false ]; then
    echo "(none visible to this process)"
fi

echo
echo "== Touchscreen device-tree candidates =="
nodes=$(find "$root" -type d \( -name "touchscreen@*" -o -name "adaptive-touchscreen@*" -o -iname "*touchscreen*" \) 2>/dev/null || true)
printf "%s\n" "$nodes"

node=$(printf "%s\n" "$nodes" | sed -n "1p")
if [ -z "$node" ]; then
    echo "No touchscreen-named DT node found."

    echo
    echo "== Local fallback: properties =="
    getprop 2>/dev/null | grep -iE "touch|focal|ft5|fts|goodix|panel|lcd" || echo "(no matching properties visible)"

    echo
    echo "== Local fallback: adaptive touchscreen config =="
    for cfg in /vendor/etc/sinput/adaptive_ts.conf /vendor/etc/sinput/fts_ts.conf /vendor/etc/sinput/NVTCapacitiveTouchScreen.conf
    do
        if [ -r "$cfg" ]; then
            echo "--- $cfg"
            cat "$cfg"
        fi
    done

    echo
    echo "== Local fallback: module load metadata =="
    found_module_metadata=false
    for meta in \
        /vendor_dlkm/lib/modules/modules.load \
        /vendor_dlkm/lib/modules/modules.load.recovery \
        /vendor_dlkm/lib/modules/modules.dep \
        /vendor_dlkm/lib/modules/modules.alias \
        /vendor/etc/modules.load \
        /odm/etc/modules.load
    do
        [ -r "$meta" ] || continue
        matches=$(grep -iE "focal|ft5|fts|il79451|touch|adaptive|novatek|nvt" "$meta" 2>/dev/null || true)
        if [ -n "$matches" ]; then
            found_module_metadata=true
            echo "--- $meta"
            printf "%s\n" "$matches"
        fi
    done
    [ "$found_module_metadata" = true ] || echo "(no matching accessible module-load metadata)"

    echo
    echo "== Local fallback: loaded modules =="
    if [ -r /proc/modules ]; then
        grep -iE "touch|focal|ft5|fts|goodix|adaptive" /proc/modules || echo "(no matching loaded modules)"
    else
        echo "/proc/modules not readable"
    fi

    echo
    echo "== Local fallback: module/file names =="
    found_files=false
    for base in /vendor/lib/modules /vendor_dlkm/lib/modules /odm/lib/modules /vendor/etc /odm/etc /vendor/firmware
    do
        [ -d "$base" ] || continue
        matches=$(find "$base" -maxdepth 4 -type f 2>/dev/null | grep -iE "touch|focal|ft5|fts|goodix|adaptive" || true)
        if [ -n "$matches" ]; then
            found_files=true
            printf "%s\n" "$matches"
        fi
    done
    [ "$found_files" = true ] || echo "(no matching accessible files)"

    echo
    echo "== Local fallback: /proc input inventory =="
    if [ -r /proc/bus/input/devices ]; then
        cat /proc/bus/input/devices
    else
        echo "/proc/bus/input/devices not readable"
    fi

    echo
    echo "== Local fallback: Android input service =="
    if command -v dumpsys >/dev/null 2>&1; then
        dumpsys input 2>&1 | sed -n "1,160p"
    else
        echo "dumpsys not available in PATH"
    fi

    echo
    echo "== Local fallback: sysfs names =="
    find /sys/devices /sys/module -maxdepth 6 \( -iname "*touch*" -o -iname "*focal*" -o -iname "*ft5*" -o -iname "*goodix*" -o -iname "*adaptive*" \) 2>/dev/null | sed -n "1,160p"

    echo
    echo "== Input devices =="
    visible_input=false
    for d in /sys/class/input/event*
    do
        [ -e "$d" ] || continue
        if [ -r "$d/device/name" ]; then
            visible_input=true
            printf "%s  " "$(basename "$d")"
            cat "$d/device/name"
        fi
    done
    [ "$visible_input" = true ] || echo "(none visible to this process)"
    exit 0
fi

echo
echo "== Selected live DT node =="
echo "$node"
text_property "$node/compatible" compatible
text_property "$node/controller" controller
text_property "$node/status" status
hex_property "$node/reg" reg
hex_property "$node/gpios" gpios

for f in "$node"/*supply
do
    [ -e "$f" ] || continue
    hex_property "$f" "$(basename "$f")"
done

parent=$(dirname "$node")
echo
echo "== Parent bus node =="
echo "$parent"
text_property "$parent/compatible" compatible
text_property "$parent/status" status
text_property "$parent/clock-names" clock-names
hex_property "$parent/reg" reg
hex_property "$parent/clock-frequency" clock-frequency
hex_property "$parent/clocks" clocks
hex_property "$parent/pinctrl-0" pinctrl-0
hex_property "$parent/pinctrl-1" pinctrl-1

echo
echo "== Matching Linux I2C device =="
matched=false
for d in /sys/bus/i2c/devices/*
do
    [ -e "$d" ] || continue
    of=$(readlink -f "$d/of_node" 2>/dev/null || true)
    if [ "$of" = "$node" ]; then
        matched=true
        echo "device: $(basename "$d")"
        [ -r "$d/name" ] && { printf "name: "; cat "$d/name"; }
        [ -r "$d/modalias" ] && { printf "modalias: "; cat "$d/modalias"; }
        driver=$(readlink -f "$d/driver" 2>/dev/null || true)
        [ -n "$driver" ] && echo "driver: $driver"
    fi
done
if [ "$matched" = false ]; then
    echo "(no matching sysfs I2C device visible)"
fi

echo
echo "== Input devices =="
for d in /sys/class/input/event*
do
    [ -e "$d" ] || continue
    if [ -r "$d/device/name" ]; then
        printf "%s  " "$(basename "$d")"
        cat "$d/device/name"
    fi
done
