# Cheap Phone OS — MIRO A1 kernel foundation
#
# This is a Kconfig fragment, not a complete defconfig.
# Physical receipt:
#   ro.board.platform=sp9863a
#   ro.hardware=s9863a1h10_go_32b
#   ro.boot.hardware=s9863a1h10_go_32b
#
# Start with mechanisms known to exist upstream. Board-specific drivers that
# are not yet proven for this MIRO remain deliberately absent.

# Spreadtrum / UNISOC platform
CONFIG_ARCH_SPRD=y

# Device tree / firmware description
CONFIG_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y

# Console and UART
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_SPRD=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SPRD=y

# GPIO and external interrupt controller
CONFIG_GPIOLIB=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y

# DMA
CONFIG_DMADEVICES=y
CONFIG_DMA_ENGINE=y
CONFIG_SPRD_DMA=y

# Clocks
CONFIG_COMMON_CLK=y
CONFIG_SPRD_SC9863A_CLK=y

# Generic power / reset / pin-control machinery.
# The exact MIRO pin controller and regulator topology still come from the
# physical device tree/vendor source; do not substitute the SC9860 pin map.
CONFIG_PINCTRL=y
CONFIG_REGULATOR=y
CONFIG_RESET_CONTROLLER=y

# eMMC / SD / SDIO
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD=y

# USB framework. Controller/PHY selection remains board evidence, not guesswork.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y

# Basic block/filesystem machinery for the first userspace
CONFIG_BLOCK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=y
