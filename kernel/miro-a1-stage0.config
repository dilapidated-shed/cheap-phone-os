# Cheap Phone OS — MIRO A1 stage-0 additions
#
# Merge this over the public SharkL3 ARM32 defconfig. Keep the donor's
# hardware settings intact for the first compilation receipt.
# This fragment is compiled in the nested validation PR before mainline merge.

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y

# The stage-0 ramdisk is supplied separately when the eventual boot image is
# assembled from observed MIRO parameters.
CONFIG_INITRAMFS_SOURCE=""
